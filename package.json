{
  "name": "asset-manager-vercel-supabase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev --turbopack",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "backup:full": "node --use-system-ca scripts/full-backup.mjs",
    "restore:full": "node --use-system-ca scripts/full-restore.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "exceljs": "^4.4.0",
    "googleapis": "^189.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "qs": "6.17.1",
    "uuid": "11.1.1",
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "rimraf": "6.1.4",
    "brace-expansion": "5.0.12"
  },
  "browserslist": [
    "chrome 64",
    "edge 79",
    "firefox 67",
    "safari 12",
    "ios_saf 12.0-12.5"
  ]
}
