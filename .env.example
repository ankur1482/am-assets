NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=https://gupta.vercel.app
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_SHARED_DRIVE_FOLDER_ID
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=BASE64_ENCODED_SERVICE_ACCOUNT_JSON_RECOMMENDED
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_WEB_CLIENT_SECRET
GOOGLE_OAUTH_COOKIE_SECRET=LONG_RANDOM_LOCAL_SECRET

# Optional: MCX spot bullion feed. Without this, bullion cards fall back to city spot rates.
METALS_DEV_API_KEY=YOUR_METALS_DEV_API_KEY

# Optional stock quote providers. Keys stay on the server; Yahoo remains the final fallback.
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY
POLYGON_API_KEY=YOUR_POLYGON_API_KEY
# Optional: provider attempt order (Yahoo is always retained as a fallback).
MARKET_DATA_PROVIDERS=twelvedata,alphavantage,polygon,yahoo
# Optional paid Alpha Vantage setting for supported US quotes: realtime or delayed.
ALPHA_VANTAGE_ENTITLEMENT=

# Optional: server-side AI Portfolio Analyst. Groq is preferred when both are set.
# Never prefix either key with NEXT_PUBLIC_.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_AI_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_AI_MODEL=gpt-5.5
# Supported values: low, medium, high, xhigh.
OPENAI_AI_REASONING_EFFORT=medium

# Optional: Upstox OAuth/API integration. Keep these server-side only.
UPSTOX_API_KEY=YOUR_UPSTOX_API_KEY
UPSTOX_API_SECRET=YOUR_UPSTOX_API_SECRET
UPSTOX_REDIRECT_URI=https://gupta.vercel.app/api/upstox/callback
# Optional fallback token for server-side checks; OAuth callback stores a browser cookie token.
UPSTOX_ACCESS_TOKEN=YOUR_UPSTOX_ACCESS_TOKEN
